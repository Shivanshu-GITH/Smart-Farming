# Copy to .env and fill in. All optional — the compute endpoints work without these.

# Persistence. Zero-config SQLite works out of the box (enables login + saved
# fields). Leave empty to run fully stateless. For production use Postgres:
#   postgresql+psycopg://smartfarm:smartfarm@localhost:5432/smartfarm
DATABASE_URL=sqlite+aiosqlite:///./smartfarm.db

# Redis cache. Leave empty to use in-process LRU cache.
REDIS_URL=

# Open-Meteo needs no key. OpenWeather (optional fallback) does.
OPENWEATHER_API_KEY=

# NDVI — FREE via Copernicus Data Space (dataspace.copernicus.eu):
#   1. Register (free) -> User Settings -> OAuth clients -> Create
#   2. Paste client id/secret below AND set the base URL to the free host.
# Leave empty to skip NDVI. The commercial services.sentinel-hub.com also works.
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
SENTINELHUB_BASE_URL=https://sh.dataspace.copernicus.eu

# Mandi prices — FREE from data.gov.in. Register at data.gov.in for an API key
# (instant). Empty -> curated farm-gate estimates.
DATA_GOV_API_KEY=

# AI advisory + photo pest-ID — bring your own key; whichever is set gets used.
# Selection order when advisory_provider=auto: claude -> gemini -> groq -> openai.
# Claude is paid and leads because setting its key is a deliberate choice;
# delete ANTHROPIC_API_KEY and it falls back to the free tiers on its own.
# Photo diagnosis needs a vision provider (claude / gemini / openai).
ADVISORY_PROVIDER=auto

# Anthropic Claude — PAID. Get a key at console.anthropic.com -> API Keys
# (starts with "sk-ant-"). Billing must have credit or calls return 400.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini — FREE, no card, multimodal. Get a key at aistudio.google.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq — FREE, no card, very fast (text-only for us). Key at console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI — paid fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google sign-in (optional). OAuth "Web application" client id from
# console.cloud.google.com; the SAME id goes in apps/web/.env.local as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. Empty disables /auth/google.
GOOGLE_CLIENT_ID=

# "development" (default) or "production". Production refuses the default
# JWT secret and never echoes OTP codes in API responses.
ENVIRONMENT=development

# Auth. CHANGE jwt_secret before production (unset = random per-process secret;
# sessions won't survive restarts). Set OTP_DEV_MODE=false once an SMS gateway
# is wired up (otherwise OTP codes are returned in the API response in dev).
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_MINUTES=10080
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true

# CORS — comma separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
