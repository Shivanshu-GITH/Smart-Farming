# Copy to .env and fill in. All optional — the compute endpoints work without these.

# Persistence (Postgres + PostGIS). Leave empty to run stateless.
DATABASE_URL=

# Redis cache. Leave empty to use in-process LRU cache.
REDIS_URL=

# Open-Meteo needs no key. OpenWeather (optional fallback) does.
OPENWEATHER_API_KEY=

# NDVI — FREE via Copernicus Data Space (dataspace.copernicus.eu):
#   1. Register (free) -> User Settings -> OAuth clients -> Create
#   2. Paste client id/secret below AND set the base URL to the free host.
# Leave empty to skip NDVI. The commercial services.sentinel-hub.com also works.
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
SENTINELHUB_BASE_URL=https://sh.dataspace.copernicus.eu

# Mandi prices — FREE from data.gov.in. Register at data.gov.in for an API key
# (instant). Empty -> curated farm-gate estimates.
DATA_GOV_API_KEY=

# Anthropic (Claude advisory + photo pest-ID). NOT free — pay-as-you-go; new
# accounts get a small trial credit. To minimise cost set the cheapest model.
ANTHROPIC_API_KEY=
ADVISORY_MODEL=claude-haiku-4-5

# Auth. CHANGE jwt_secret before production. Set OTP_DEV_MODE=false once an SMS
# gateway is wired up (otherwise OTP codes are returned in the API response).
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_MINUTES=10080
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true

# CORS — comma separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
